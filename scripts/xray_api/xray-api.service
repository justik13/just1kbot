[Unit]
Description=Just1kBot Xray API Agent
After=network.target xray.service
Wants=xray.service

[Service]
Type=simple
User=xrayapi
Group=xrayapi
WorkingDirectory=/opt/xray-api
EnvironmentFile=-/etc/xray-api/config.env
ExecStart=/opt/xray-api/venv/bin/uvicorn app:app --host 127.0.0.1 --port 5001 --workers 1 --log-level info
Restart=always
RestartSec=3
LimitNOFILE=65535

# Security hardening & privilege isolation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xray-api /etc/just1knode /var/lib/xray-api

[Install]
WantedBy=multi-user.target
