[Unit]
Description=Just1kBot AmneziaWG API Service
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/amnezia-api
EnvironmentFile=-/etc/amnezia-api/config.env
ExecStart=/opt/amnezia-api/venv/bin/uvicorn app:app --host 127.0.0.1 --port 4001 --workers 1 --log-level info
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
