```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
lib/
lib64/

# Build and distribution
build/
dist/
*.egg-info/
.coverage
coverage/
htmlcov/

# Environment variables
.env
.env.local
.env.*

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS
.DS_Store
Thumbs.db
```