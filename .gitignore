```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs and temporary files
*.log
*.tmp

# Environment variables
.env
.env.local
*.env.*

# Dependencies and build artifacts
venv/
.venv/
node_modules/
dist/
build/
target/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# OS specific
.DS_Store
Thumbs.db
```