```gitignore
# Python compiled files
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
env/
.env
.env.local
.env.*

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Editors and IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
htmlcov/
coverage/

# Build and distribution artifacts
dist/
build/
*.egg-info/

# Alembic migrations (if not intended to be versioned)
alembic/versions/*.py

# Database
*.db
*.db-journal

# Cache directories
.mypy_cache/
.pytest_cache/
.hypothesis/
```