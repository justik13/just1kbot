{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "cdn.example.com",
            "port": 443,
            "users": [
              {
                "id": "a2b9d4e1-73c5-4812-b964-f3e7b85a1902",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "cdn.example.com",
          "alpn": [
            "h2"
          ]
        },
        "xhttpSettings": {
          "mode": "packet-up",
          "path": "/api/v3/secure-data",
          "xPaddingObfsMode": true,
          "xPaddingKey": "dc",
          "xPaddingHeader": "X-Cache",
          "xPaddingMethod": "tokenish",
          "xPaddingPlacement": "queryInHeader",
          "scMaxEachPostBytes": 1000000,
          "scMinPostsIntervalMs": 30,
          "scMaxBufferedPosts": 30,
          "uplinkHTTPMethod": "OPTIONS"
        }
      }
    }
  ]
}