{
    auto_https off
    servers {
        max_header_size 8KB
    }
    order rate_limit before reverse_proxy
}

:80 {
    @amnezia_bridge path /amnezia/open/*
    handle @amnezia_bridge {
        rate_limit {
            zone amnezia_bridge_zone {
                key {remote_host}
                events 30
                window 1m
            }
        }
        request_body {
            max_size 2KB
        }
        reverse_proxy bot:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy bot:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
}
