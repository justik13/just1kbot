# ============================================================
# just1kbot Bot — .env.example
# ============================================================
# Скопируйте этот файл в .env и заполните реальные значения.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Никогда не коммитьте .env в git.
# ============================================================


# ------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------

# Токен бота от @BotFather
BOT_TOKEN='1234567890:CHANGE_ME_TELEGRAM_BOT_TOKEN'

# Telegram ID администраторов в JSON-массиве.
ADMIN_IDS='[111111111]'

# Username поддержки.
# Можно с @ или без. Обязательно замените placeholder реальным username.
SUPPORT_USERNAME='CHANGE_ME_SUPPORT_USERNAME'


# ------------------------------------------------------------
# База данных PostgreSQL
# ------------------------------------------------------------

# В Docker deployment DATABASE_URL формируется автоматически из
# POSTGRES_HOST/POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
# Значение ниже оставлено как placeholder для локального запуска вне Docker.
DATABASE_URL='postgresql+asyncpg://just1kbot:CHANGE_ME_DB_PASSWORD@localhost:5432/just1kbot_bot'

# Переменные для Docker Compose.
# POSTGRES_PASSWORD указывается как raw-значение: вручную URL-encode делать НЕ нужно.
# Docker entrypoint автоматически кодирует пароль при формировании DATABASE_URL.
POSTGRES_USER='just1kbot'
POSTGRES_PASSWORD='CHANGE_ME_DB_PASSWORD'
POSTGRES_DB='just1kbot_bot'


# ------------------------------------------------------------
# Шифрование чувствительных данных в БД
# ------------------------------------------------------------

# Обязательный ключ шифрования.
# Используется для хранения API-ключей серверов Amnezia.
#
# Сгенерировать:
#
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# ВАЖНО:
# - не теряйте этот ключ;
# - не меняйте его после создания серверов, иначе старые API-ключи не расшифруются;
# - храните в бэкапах вместе с БД.
DB_ENCRYPTION_KEY='CHANGE_ME_BASE64_32_BYTES_FERNET_KEY'


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

# Redis используется для FSM, lock'ов и временных данных.
# Для production обязательно используйте пароль.

# В Docker deployment REDIS_URL формируется автоматически из
# REDIS_HOST и REDIS_PASSWORD.
# REDIS_PASSWORD указывается как raw-значение: вручную URL-encode делать НЕ нужно.
REDIS_URL='redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0'
REDIS_PASSWORD='CHANGE_ME_REDIS_PASSWORD'


# ------------------------------------------------------------
# YooKassa и внутренний баланс
# ------------------------------------------------------------

# Обязательные production-реквизиты YooKassa.
YOOKASSA_SHOP_ID='CHANGE_ME_YOOKASSA_SHOP_ID'
YOOKASSA_SECRET_KEY='CHANGE_ME_YOOKASSA_SECRET_KEY'
YOOKASSA_RETURN_URL='https://t.me/{bot_username}'

# Обязательный публичный ключ (age recipient) для шифрования бекапов БД.
# Получить можно командой: age-keygen
# Приватный age key на production-сервере хранить нельзя.
BACKUP_AGE_RECIPIENT='age1...CHANGE_ME_BACKUP_AGE_RECIPIENT'

# Обязательный публичный HTTPS-домен для webhook и health endpoint.
DOMAIN='vpn.example.com'

# Обязательный реальный email для выпуска и продления TLS-сертификата.
SSL_EMAIL='owner@example.com'

# Лимиты продукта задаются в целых рублях.
BALANCE_MIN_TOPUP_RUB=10
BALANCE_MAX_CUSTOM_TOPUP_RUB=5000
BALANCE_MAX_AVAILABLE_RUB=10000
BALANCE_MAX_PRESET_RUB=1000
BALANCE_MAX_UNFINISHED_TOPUPS=3
BALANCE_MAX_TOPUP_CREATIONS_24H=10
BALANCE_MAX_PRESET_OPTIONS=6


# ------------------------------------------------------------
# Настройки доступа к локальным сетям / SSRF protection
# ------------------------------------------------------------

# По умолчанию бот запрещает подключение к локальным адресам.
# Это защита от SSRF.

# Разрешать ли локальный HTTP.
# Ставьте true ТОЛЬКО если Amnezia API находится локально, например:
#   http://127.0.0.1:4001
#
# Для production с внешним HTTPS API оставляйте false.
ALLOW_LOCAL_HTTP=false

# Разрешать ли локальный HTTPS.
# Обычно не нужно.
ALLOW_LOCAL_HTTPS=false
