# ============================================================
# just1kbot Bot — .env.example
# ============================================================
# Скопируйте этот файл в .env и заполните реальные значения.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Никогда не коммитьте .env в git.
# ============================================================


# ------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------
BOT_TOKEN='1234567890:CHANGE_ME_TELEGRAM_BOT_TOKEN'
ADMIN_IDS='[111111111]'
SUPPORT_USERNAME='CHANGE_ME_SUPPORT_USERNAME'


# ------------------------------------------------------------
# База данных PostgreSQL
# ------------------------------------------------------------
DATABASE_URL='postgresql+asyncpg://just1kbot:CHANGE_ME_DB_PASSWORD@localhost:5432/just1kbot_bot'
POSTGRES_USER='just1kbot'
POSTGRES_PASSWORD='CHANGE_ME_DB_PASSWORD'
POSTGRES_DB='just1kbot_bot'


# ------------------------------------------------------------
# Шифрование чувствительных данных в БД
# ------------------------------------------------------------
DB_ENCRYPTION_KEY='CHANGE_ME_BASE64_32_BYTES_FERNET_KEY'


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL='redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0'
REDIS_PASSWORD='CHANGE_ME_REDIS_PASSWORD'


# ------------------------------------------------------------
# YooKassa и внутренний баланс
# ------------------------------------------------------------
YOOKASSA_SHOP_ID='CHANGE_ME_YOOKASSA_SHOP_ID'
YOOKASSA_SECRET_KEY='CHANGE_ME_YOOKASSA_SECRET_KEY'
YOOKASSA_RETURN_URL='https://t.me/{bot_username}'

# Публичный age recipient для шифрования backup БД.
# Приватный age key на production-сервере хранить нельзя.
BACKUP_AGE_RECIPIENT='age1...CHANGE_ME_BACKUP_AGE_RECIPIENT'

# Необязательное независимое хранилище encrypted backup.
# Рекомендуется использовать HTTPS presigned PUT URL с {filename}, например:
# BACKUP_REMOTE_URI='https://storage.example/upload/{filename}'
# Если endpoint требует bearer token:
# BACKUP_REMOTE_TOKEN='CHANGE_ME_REMOTE_BACKUP_TOKEN'
BACKUP_REMOTE_URI=''
BACKUP_REMOTE_TOKEN=''

DOMAIN='vpn.example.com'
SSL_EMAIL='owner@example.com'

BALANCE_MIN_TOPUP_RUB=10
BALANCE_MAX_CUSTOM_TOPUP_RUB=5000
BALANCE_MAX_AVAILABLE_RUB=10000
BALANCE_MAX_PRESET_RUB=1000
BALANCE_MAX_UNFINISHED_TOPUPS=3
BALANCE_MAX_TOPUP_CREATIONS_24H=10
BALANCE_MAX_PRESET_OPTIONS=6


# ------------------------------------------------------------
# Настройки доступа к локальным сетям / SSRF protection
# ------------------------------------------------------------
ALLOW_LOCAL_HTTP=false
ALLOW_LOCAL_HTTPS=false
