{
	email {$SSL_EMAIL}
	servers {
		max_header_size 8KB
		strict_sni_host
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

http:// {
	@domain host {$DOMAIN} {$SUBSCRIPTION_DOMAIN:sub.invalid.localhost} {$SUBSCRIPTION_BACKUP_DOMAIN:backup.invalid.localhost}
	redir @domain https://{host}{uri} permanent
	abort
}

{$DOMAIN} {
	log {
		output stdout
		format console
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Permitted-Cross-Domain-Policies "none"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	@yookassa_allowed {
		path /webhook/* /yookassa/*
		remote_ip 185.71.76.0/27 185.71.77.0/27 77.75.153.0/25 77.75.154.128/25 77.75.156.11 77.75.156.35 2a02:5180::/32 {$YOOKASSA_EXTRA_IPS:127.0.0.1/32}
	}
	handle @yookassa_allowed {
		header X-Frame-Options "DENY"
		reverse_proxy bot:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	@subscription_paths path {$WHITE_INTERNET_SUB_PATH_PREFIX:/sub/wl}/* /sub/*
	handle @subscription_paths {
		header X-Frame-Options "DENY"
		log_skip
		reverse_proxy bot:8080 {
			header_up X-Real-IP {client_ip}
		}
	}

	@app_allowed path /app /app/* /api/app/*
	handle @app_allowed {
		header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org telegram:;"
		reverse_proxy bot:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		respond "Not Found" 404
	}

	handle_errors {
		header {
			Content-Type "text/html; charset=utf-8"
			Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
			Pragma "no-cache"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			X-Robots-Tag "noindex, nofollow, noarchive"
			X-Permitted-Cross-Domain-Policies "none"
			Permissions-Policy "geolocation=(), camera=(), microphone=()"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; form-action 'none'; frame-ancestors 'none';"
		}
		@rate_limited `{err.status_code} == 429`
		handle @rate_limited {
			respond `<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>HTTP 429 — Just1k</title><style>*{box-sizing:border-box;margin:0;padding:0;}body{background:#050505;color:#f4f4f5;font-family:"IBM Plex Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px;}.card{background:#0e0e11;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:24px;max-width:400px;width:100%;}.meta{display:flex;align-items:center;gap:8px;font-family:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-variant-numeric:tabular-nums;color:#71717a;margin-bottom:16px;}.dot{width:6px;height:6px;border-radius:999px;background:#fbbf24;flex-shrink:0;}h1{font-size:18px;font-weight:500;letter-spacing:-0.01em;color:#f4f4f5;margin-bottom:8px;}p{color:#a1a1aa;font-size:14px;margin-bottom:20px;}.btn{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:8px;background:#f4f4f5;color:#050505;font-size:13px;font-weight:500;text-decoration:none;transition:opacity .15s ease;}.btn:hover{opacity:.88;}</style></head><body><main class="card"><div class="meta"><span class="dot"></span><span>HTTP 429</span></div><h1>Слишком много запросов</h1><p>Превышен лимит обращений. Подождите несколько секунд и повторите попытку.</p><a class="btn" href="">Обновить</a></main></body></html>` 429
		}
		handle {
			respond `<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>HTTP {err.status_code} — Just1k</title><style>*{box-sizing:border-box;margin:0;padding:0;}body{background:#050505;color:#f4f4f5;font-family:"IBM Plex Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px;}.card{background:#0e0e11;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:24px;max-width:400px;width:100%;}.meta{display:flex;align-items:center;gap:8px;font-family:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-variant-numeric:tabular-nums;color:#71717a;margin-bottom:16px;}.dot{width:6px;height:6px;border-radius:999px;background:#f87171;flex-shrink:0;}h1{font-size:18px;font-weight:500;letter-spacing:-0.01em;color:#f4f4f5;margin-bottom:8px;}p{color:#a1a1aa;font-size:14px;margin-bottom:20px;}.btn{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:8px;background:#f4f4f5;color:#050505;font-size:13px;font-weight:500;text-decoration:none;transition:opacity .15s ease;}.btn:hover{opacity:.88;}</style></head><body><main class="card"><div class="meta"><span class="dot"></span><span>HTTP {err.status_code}</span></div><h1>Сервис временно недоступен</h1><p>Не удалось получить ответ от сервера. Повторите попытку через несколько секунд.</p><a class="btn" href="">Обновить</a></main></body></html>` {err.status_code}
		}
	}
}

