+++ b/tests/test_install_recovery_hotfix.py
@@ -0,0 +1,83 @@
+import pathlib
+import unittest
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+DEPLOY = (ROOT / "scripts" / "deploy.sh").read_text(encoding="utf-8")
+UNINSTALL = (ROOT / "scripts" / "uninstall.sh").read_text(encoding="utf-8")
+
+
+class IncompleteInstallRecoveryTests(unittest.TestCase):
+    def test_install_state_uses_env_and_service_unit(self):
+        self.assertIn("RECOVERY_INSTALL=false", DEPLOY)
+        self.assertIn("продолжение незавершённой установки", DEPLOY)
+        self.assertIn('if [[ -f "$UNIT_FILE" ]]', DEPLOY)
+        self.assertIn("Systemd unit существует, но production .env отсутствует", DEPLOY)
+
+    def test_recovery_requires_empty_application_tables(self):
+        self.assertIn("validate_recovery_install_state", DEPLOY)
+        self.assertIn("c.relname = 'alembic_version'", DEPLOY)
+        self.assertIn("Незавершённая установка содержит application data", DEPLOY)
+
+        run_deploy = DEPLOY[DEPLOY.index("run_deploy() {") :]
+        self.assertLess(
+            run_deploy.index("validate_recovery_install_state"),
+            run_deploy.index("configure_operational_transaction"),
+        )
+        self.assertIn(
+            '[[ "$INITIAL_INSTALL" == true || "$RECOVERY_INSTALL" == true ]]',
+            run_deploy,
+        )
+
+    def test_established_update_fails_before_backup_when_tooling_is_missing(self):
+        self.assertIn("validate_installed_backup_tooling", DEPLOY)
+        self.assertIn("Обновление остановлено до snapshot, backup и миграций", DEPLOY)
+        self.assertIn('if ! systemctl start just1kbot-backup.service; then', DEPLOY)
+        self.assertIn("Не удалось запустить just1kbot-backup.service", DEPLOY)
+
+    def test_service_runtime_access_and_home_are_explicit(self):
+        for marker in (
+            'BOT_HOME="/home/$BOT_USER"',
+            "ensure_service_account_home",
+            'useradd -r -M -d "$BOT_HOME"',
+            'runuser -u "$BOT_USER" -- test -x "$VENV_DIR/bin/python"',
+            'env HOME="$RUNTIME_DIR" "$VENV_DIR/bin/python"',
+            "Environment=HOME=${RUNTIME_DIR}",
+            'env HOME="$RUNTIME_DIR" PYTHONPATH="$PROJECT_DIR"',
+            "env HOME=/run/just1kbot PYTHONPATH=\"$PROJECT_DIR\"",
+            "ProtectHome=true",
+        ):
+            self.assertIn(marker, DEPLOY)
+
+    def test_full_purge_removes_exact_service_home(self):
+        for marker in (
+            "BOT_HOME=/home/just1kbot",
+            "purge_service_account",
+            '[[ "$configured_home" == "$BOT_HOME" ]]',
+            'rm -rf --one-file-system -- "$BOT_HOME"',
+            "service account home still exists after purge",
+        ):
+            self.assertIn(marker, UNINSTALL)
+
+        purge_saved = UNINSTALL[UNINSTALL.index("purge_saved(){") :]
+        self.assertIn("purge_service_account", purge_saved)
+        self.assertNotIn('userdel "$BOT_USER"\n}', purge_saved)
+
+
+if __name__ == "__main__":
+    unittest.main()
