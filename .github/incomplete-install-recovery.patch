+validate_installed_backup_tooling() {
+    local required
+    for required in \
+        /usr/local/bin/just1kbot-backup.sh \
+        /etc/systemd/system/just1kbot-backup.service \
+        "$BACKUP_CONF"; do
+        [[ -f "$required" && ! -L "$required" ]] || {
+            error "Установленная система не имеет безопасного backup-компонента: $required"
+            error "Обновление остановлено до snapshot, backup и миграций"
+            return 1
+        }
+    done
+
+    [[ -x /usr/local/bin/just1kbot-backup.sh ]] || {
+        error "Backup script не является исполняемым"
+        return 1
+    }
+
+    systemctl daemon-reload
+    systemctl cat just1kbot-backup.service >/dev/null 2>&1 || {
+        error "Systemd не видит just1kbot-backup.service"
+        return 1
+    }
+}
