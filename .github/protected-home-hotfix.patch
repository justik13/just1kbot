diff --git a/scripts/deploy.sh b/scripts/deploy.sh
index 4068257..0000000 100755
--- a/scripts/deploy.sh
+++ b/scripts/deploy.sh
@@ -32,6 +32,8 @@ unset DEPLOY_FUNCTIONS_ONLY
 SOURCE_DIR="$ROOT_DIR"
 RUNTIME_DIR="/run/just1kbot"
 HEARTBEAT_FILE="$RUNTIME_DIR/heartbeat"
+BOT_ACCOUNT_HOME="/home/$BOT_USER"
+SERVICE_HOME="$RUNTIME_DIR"
 
 # shellcheck source=lib/postgresql.sh
 source "$POSTGRES_LIBRARY"
@@ -117,10 +119,53 @@ ensure_env_permissions() {
     validate_env_file
 }
 
+validate_bot_account_home() {
+    local configured_home
+    configured_home=$(getent passwd "$BOT_USER" | cut -d: -f6) || {
+        error "Не удалось прочитать account service user $BOT_USER"
+        return 1
+    }
+    [[ "$configured_home" == "$BOT_ACCOUNT_HOME" ]] || {
+        error "Неожиданный home service user: $configured_home"
+        return 1
+    }
+    [[ -d "$BOT_ACCOUNT_HOME" && ! -L "$BOT_ACCOUNT_HOME" ]] || {
+        error "Home service user отсутствует, не является directory или является symlink"
+        return 1
+    }
+
+    chown "$BOT_USER:$BOT_USER" "$BOT_ACCOUNT_HOME"
+    chmod 0750 "$BOT_ACCOUNT_HOME"
+
+    if [[ -e "$BOT_ACCOUNT_HOME/.postgresql" || -L "$BOT_ACCOUNT_HOME/.postgresql" ]]; then
+        [[ -d "$BOT_ACCOUNT_HOME/.postgresql" && ! -L "$BOT_ACCOUNT_HOME/.postgresql" ]] || {
+            error "Service-user .postgresql path небезопасен"
+            return 1
+        }
+    fi
+    install -d -o "$BOT_USER" -g "$BOT_USER" -m 0700 \
+        "$BOT_ACCOUNT_HOME/.postgresql"
+}
+
 setup_user_and_dirs() {
     if ! id "$BOT_USER" >/dev/null 2>&1; then
-        useradd -r -m -s /bin/bash "$BOT_USER"
+        [[ ! -L "$BOT_ACCOUNT_HOME" ]] || {
+            error "Service-user home является symlink"
+            return 1
+        }
+        if [[ -e "$BOT_ACCOUNT_HOME" ]]; then
+            [[ -d "$BOT_ACCOUNT_HOME" ]] || {
+                error "Service-user home существует и не является directory"
+                return 1
+            }
+            useradd -r -M -d "$BOT_ACCOUNT_HOME" -s /bin/bash "$BOT_USER"
+        else
+            useradd -r -m -d "$BOT_ACCOUNT_HOME" -s /bin/bash "$BOT_USER"
+        fi
     fi
+    validate_bot_account_home || return 1
 
     # The service may read the release but must never be able to rewrite code,
     # the virtualenv, deploy scripts, or .env.
@@ -315,7 +360,7 @@ init_database() {
     log "Применение Alembic migrations"
     runuser -u "$BOT_USER" -- \
-        env PYTHONPATH="$PROJECT_DIR" PYTHONDONTWRITEBYTECODE=1 \
+        env HOME="$SERVICE_HOME" PYTHONPATH="$PROJECT_DIR" PYTHONDONTWRITEBYTECODE=1 \
         bash -c "cd '$PROJECT_DIR' && '$VENV_DIR/bin/alembic' upgrade head" \
         2>> "$LOG_FILE"
 }
@@ -359,6 +404,7 @@ Group=${BOT_USER}
 WorkingDirectory=${PROJECT_DIR}
+Environment=HOME=${SERVICE_HOME}
 Environment=PYTHONPATH=${PROJECT_DIR}
 Environment=PYTHONUNBUFFERED=1
 Environment=PYTHONDONTWRITEBYTECODE=1
@@ -460,7 +506,7 @@ cd "$PROJECT_DIR"
 timeout --signal=TERM --kill-after=5s 25s \
     runuser -u just1kbot -- \
-    env PYTHONPATH="$PROJECT_DIR" PYTHONDONTWRITEBYTECODE=1 \
+    env HOME=/run/just1kbot PYTHONPATH="$PROJECT_DIR" PYTHONDONTWRITEBYTECODE=1 \
     "$VENV_DIR/bin/python" - <<'PY'
 import asyncio
 
diff --git a/scripts/uninstall.sh b/scripts/uninstall.sh
index 98132cd..0000000 100755
--- a/scripts/uninstall.sh
+++ b/scripts/uninstall.sh
@@ -5,6 +5,7 @@ IFS=$'\n\t'
 umask 077
 
 BOT_USER=just1kbot
+BOT_HOME=/home/just1kbot
 PROJECT_DIR=/opt/just1kbot
 BACKUP_DIR=/root/backups/just1kbot
 BACKUP_CONF=/etc/just1kbot-backup.conf
@@ -487,10 +488,43 @@ remove_installed(){
     /var/log/just1kbot-rollback.log
 }
 
+safe_remove_bot_home(){
+  [[ "$BOT_HOME" == /home/just1kbot && "$BOT_HOME" != *'..'* ]] ||
+    fail 'unsafe BOT_HOME'
+  [[ ! -L "$BOT_HOME" ]] || fail 'BOT_HOME is a symlink'
+
+  if [[ -e "$BOT_HOME" ]]; then
+    [[ -d "$BOT_HOME" ]] || fail 'BOT_HOME exists and is not a directory'
+    [[ "$(realpath -m -- "$BOT_HOME")" == /home/just1kbot ]] ||
+      fail 'canonical BOT_HOME mismatch'
+    rm -rf --one-file-system -- "$BOT_HOME"
+  fi
+
+  [[ ! -e "$BOT_HOME" && ! -L "$BOT_HOME" ]] ||
+    fail 'service home still exists after purge'
+}
+
+purge_bot_user(){
+  local configured_home
+  if id "$BOT_USER" >/dev/null 2>&1; then
+    configured_home=$(getent passwd "$BOT_USER" | cut -d: -f6) ||
+      fail 'failed to read service-user account'
+    [[ "$configured_home" == "$BOT_HOME" ]] ||
+      fail "unexpected service-user home: $configured_home"
+    userdel "$BOT_USER" || fail 'failed to delete service user'
+  fi
+
+  safe_remove_bot_home
+  ! id "$BOT_USER" >/dev/null 2>&1 || fail 'service user still exists after purge'
+}
+
 purge_saved(){
   rm -rf -- "$BACKUP_DIR" "$SNAPSHOT_DIR"
   rm -f -- "$BACKUP_CONF" "$AGE_IDENTITY_DEFAULT"
-  id "$BOT_USER" >/dev/null 2>&1 && userdel "$BOT_USER"
+  purge_bot_user
 }
 
